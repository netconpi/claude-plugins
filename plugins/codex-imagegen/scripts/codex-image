#!/usr/bin/env bash
# codex-image: generate or edit raster images with Codex CLI's built-in image tool
# (image_gen.imagegen, gpt-image-2) and copy the results to the paths you choose.
# Codex is used as a backend only: no delegation, no code changes, read-only sandbox.
#
#   codex-image --out FILE [--n N] [--ref IMG]... [--edit IMG]... [--transparent]
#               [--timeout SEC] [--force] < spec.md
#
#   --out FILE      where to put the image (.png). With --n > 1: FILE-1.png ... FILE-N.png
#   --n N           variants of the same spec, 1..4 (default 1)
#   --ref IMG       reference image for style/composition/subject (repeatable, max 5 with --edit)
#   --edit IMG      image to edit; everything not asked for must stay unchanged (repeatable)
#   --transparent   transparent background (cutouts, background removal, sprites)
#   --timeout SEC   give up after SEC seconds (default 540, fits a 10-minute tool call)
#   --force         overwrite --out if it exists (default: write a -v2, -v3 ... sibling)
#
# Exit codes: 0 all images saved, 3 some saved, 1 none saved, 2 usage error.
# Env: CODEX_IMAGE_MODEL (default gpt-6.1-sol), CODEX_IMAGE_EFFORT (default low),
#      CODEX_IMAGE_HOME (run logs, default ~/.cache/codex-image), CODEX_HOME (default ~/.codex).
# Needs codex logged in with a paid ChatGPT plan (the built-in tool is not offered to API-key or Free logins).
set -euo pipefail

MODEL="${CODEX_IMAGE_MODEL:-gpt-6.1-sol}"
EFFORT="${CODEX_IMAGE_EFFORT:-low}"
RUNS="${CODEX_IMAGE_HOME:-$HOME/.cache/codex-image}"
CODEX_HOME_DIR="${CODEX_HOME:-$HOME/.codex}"

die() { echo "codex-image: $*" >&2; exit 2; }
abspath() { (cd "$(dirname "$1")" && printf '%s/%s\n' "$(pwd)" "$(basename "$1")"); }

out="" n=1 transparent=false timeout=540 force=false
refs=() edits=()
while [ $# -gt 0 ]; do
  case "$1" in
    --out) out="$2"; shift 2 ;;
    --n) n="$2"; shift 2 ;;
    --ref) [ -f "$2" ] || die "no such file $2"; refs+=("$(abspath "$2")"); shift 2 ;;
    --edit) [ -f "$2" ] || die "no such file $2"; edits+=("$(abspath "$2")"); shift 2 ;;
    --transparent) transparent=true; shift ;;
    --timeout) timeout="$2"; shift 2 ;;
    --force) force=true; shift ;;
    -h|--help) sed -n '2,23p' "$0"; exit 0 ;;
    *) die "unknown option $1" ;;
  esac
done
[ -n "$out" ] || die "--out FILE is required"
case "$n" in 1|2|3|4) ;; *) die "--n must be 1..4" ;; esac
case "$timeout" in ''|*[!0-9]*) die "--timeout must be seconds" ;; esac
total_inputs=$(( ${#refs[@]} + ${#edits[@]} ))
[ "$total_inputs" -le 5 ] || die "at most 5 input images (--ref + --edit)"
command -v codex >/dev/null 2>&1 || die "codex not found on PATH"
case "$out" in *.png|*.PNG) ;; *) out="$out.png" ;; esac
mkdir -p "$(dirname "$out")"
out="$(abspath "$out")"

spec="$(cat)"
[ -n "${spec//[[:space:]]/}" ] || die "empty spec on stdin"

login="$(codex login status 2>&1 || true)"
case "$login" in
  *"Not logged in"*|*"not logged in"*) echo "status: failed"; echo "error: codex is not logged in (run: codex login)"; exit 1 ;;
  *"API key"*) echo "warning: codex uses an API key; the built-in image tool needs a ChatGPT login" >&2 ;;
esac

run="$(date +%Y%m%d-%H%M%S)-$(basename "$out" .png | tr -c 'a-zA-Z0-9-' '-' | cut -c1-30)-$$"
rd="$RUNS/$run"; mkdir -p "$rd"
touch "$rd/started"

# ---- the instruction Codex gets -------------------------------------------------------------
{
  echo "You are an image-generation backend. Your only job is to call the built-in image generation"
  echo "tool (image_gen.imagegen) and report what it saved. Do not run shell commands, do not create,"
  echo "edit or move files, and do not use any other tool."
  echo
  if [ "$n" -eq 1 ]; then
    echo "Call the tool exactly once."
  else
    echo "Call the tool exactly $n times, once per variant, with the same spec (let each call vary naturally)."
  fi
  echo "- transparent_background: $transparent"
  if [ "$total_inputs" -gt 0 ]; then
    echo "- referenced_image_paths (pass exactly these absolute paths, in this order):"
    i=1
    for p in ${edits[@]+"${edits[@]}"}; do echo "  Image $i: $p — EDIT TARGET: change only what the spec asks; keep everything else unchanged"; i=$((i+1)); done
    for p in ${refs[@]+"${refs[@]}"}; do echo "  Image $i: $p — REFERENCE: use for style/composition/subject as the spec says; do not copy it"; i=$((i+1)); done
    echo "  Refer to them as Image 1, Image 2, ... in the prompt you send."
  else
    echo "- Omit referenced_image_paths and num_last_images_to_include: this is a new image."
  fi
  echo "- Send the spec below as the tool prompt. Keep it essentially verbatim: you may restructure it into"
  echo "  a clear spec, but do not add objects, people, text, brands or style that the spec does not imply."
  echo "  Quote any required in-image text exactly."
  echo
  echo "When done, reply with only these lines:"
  echo "IMAGE: <absolute path the tool saved>      (one line per image)"
  echo "REVISED: <revised prompt the tool reported, if any>"
  echo "If the tool is unavailable or a call fails, reply with: ERROR: <the exact error text>"
  echo
  echo "Spec:"
  echo "$spec"
} > "$rd/prompt.md"

# ---- run Codex detached, so a timeout can kill the whole process group ------------------------
if command -v setsid >/dev/null 2>&1; then
  DETACH=(setsid nohup)
elif command -v perl >/dev/null 2>&1; then
  DETACH=(nohup perl -e 'use POSIX (); POSIX::setsid(); exec @ARGV or die "exec: $!"')
else
  DETACH=(nohup)
fi
"${DETACH[@]}" bash -c '
  rd="$1"; shift
  "$@" < "$rd/prompt.md" > "$rd/events.jsonl" 2> "$rd/stderr.log"
  echo $? > "$rd/exit"
' _ "$rd" codex exec --json --ephemeral -m "$MODEL" \
    -c "model_reasoning_effort=\"$EFFORT\"" \
    -c 'approval_policy="never"' \
    -c 'sandbox_mode="read-only"' \
    --skip-git-repo-check -C "$(dirname "$out")" -o "$rd/last.md" - >/dev/null 2>&1 &
pid=$!
echo "$pid" > "$rd/pid"

end=$(( $(date +%s) + timeout ))
while [ ! -f "$rd/exit" ] && [ "$(date +%s)" -lt "$end" ]; do
  kill -0 "$pid" 2>/dev/null || break
  sleep 2
done
timed_out=false
if [ ! -f "$rd/exit" ]; then
  if kill -0 "$pid" 2>/dev/null; then
    timed_out=true
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    echo 124 > "$rd/exit"
  else
    sleep 1
    [ -f "$rd/exit" ] || echo 125 > "$rd/exit"
  fi
fi

# ---- collect the images ----------------------------------------------------------------------
thread="$(sed -n 's/.*"type":"thread.started","thread_id":"\([^"]*\)".*/\1/p' "$rd/events.jsonl" 2>/dev/null | head -1)"
: > "$rd/found.txt"
if [ -n "$thread" ] && [ -d "$CODEX_HOME_DIR/generated_images/$thread" ]; then
  ls -tr "$CODEX_HOME_DIR/generated_images/$thread"/*.png 2>/dev/null >> "$rd/found.txt" || true
fi
if [ ! -s "$rd/found.txt" ] && [ -f "$rd/last.md" ]; then
  sed -n 's/^[[:space:]]*IMAGE:[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' "$rd/last.md" | while IFS= read -r p; do
    [ -f "$p" ] && echo "$p"
  done >> "$rd/found.txt" || true
fi
if [ ! -s "$rd/found.txt" ] && [ -d "$CODEX_HOME_DIR/generated_images" ]; then
  # last resort: images written during this run (may pick up a parallel run's image; reported below)
  find "$CODEX_HOME_DIR/generated_images" -name '*.png' -newer "$rd/started" 2>/dev/null | head -"$n" >> "$rd/found.txt" || true
  [ -s "$rd/found.txt" ] && echo "warning: images located by time, not by thread; check them" >&2
fi

target_for() { # index -> destination path (never clobbers unless --force)
  local base="${out%.*}" dest v
  if [ "$n" -eq 1 ]; then dest="$out"; else dest="$base-$1.png"; fi
  if [ "$force" = false ] && [ -e "$dest" ]; then
    v=2; while [ -e "${dest%.png}-v$v.png" ]; do v=$((v+1)); done
    dest="${dest%.png}-v$v.png"
  fi
  echo "$dest"
}

saved=()
i=1
while IFS= read -r src; do
  [ "$i" -le "$n" ] || break
  dest="$(target_for "$i")"
  cp "$src" "$dest"
  saved+=("$dest")
  i=$((i+1))
done < "$rd/found.txt"

# ---- report ----------------------------------------------------------------------------------
code="$(cat "$rd/exit")"
if [ ${#saved[@]} -eq "$n" ]; then status=ok; rc=0
elif [ ${#saved[@]} -gt 0 ]; then status=partial; rc=3
else status=failed; rc=1; fi
echo "status: $status (${#saved[@]}/$n)"
echo "thread: ${thread:-?}   codex exit: $code   log: $rd"
if [ ${#saved[@]} -gt 0 ]; then
  echo "images:"
  for f in "${saved[@]}"; do
    dims="$(file "$f" 2>/dev/null | sed -n 's/.*PNG image data, \([0-9]* x [0-9]*\).*/\1/p')"
    echo "  $f${dims:+  ($dims)}"
  done
fi
grep -h '^REVISED:' "$rd/last.md" 2>/dev/null | head -"$n" | sed 's/^REVISED:[[:space:]]*/revised prompt: /' || true
if [ "$rc" -ne 0 ]; then
  [ "$timed_out" = true ] && echo "error: timed out after ${timeout}s"
  grep -h '^ERROR:' "$rd/last.md" 2>/dev/null | sed 's/^ERROR:[[:space:]]*/error: /' || true
  grep -h '"type":"turn.failed"\|"type":"error"' "$rd/events.jsonl" 2>/dev/null | tail -2 | cut -c1-300 || true
  if [ -s "$rd/stderr.log" ]; then grep -v '^[[:space:]]*$' "$rd/stderr.log" | tail -3; fi
fi
exit "$rc"
